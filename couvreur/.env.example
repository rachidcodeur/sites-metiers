# Modèle — copier en .env et demander les valeurs à un membre de l'équipe.
# Le .env réel n'est JAMAIS versionné : il contient la clé Supabase.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_TABLE_COUVREUR=leads_couvreur

# 0 OBLIGATOIRE sur o2switch. En mode relatif (1), le formulaire poste vers
# /rest/v1/... sur le domaine du site, qui est statique -> erreur 405.
SUPABASE_USE_RELATIVE_API=0
